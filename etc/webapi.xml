<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/epuzzle/import-export/csv-import" method="POST">
        <service class="EPuzzle\ImportExport\Api\CsvManagementInterface" method="import"/>
        <resources>
            <resource ref="EPuzzle_ImportExport::csv_import"/>
        </resources>
    </route>
    <route url="/V1/epuzzle/import-export/csv-to-batches" method="POST">
        <service class="EPuzzle\ImportExport\Api\CsvManagementInterface" method="toBatches"/>
        <resources>
            <resource ref="EPuzzle_ImportExport::csv_import"/>
        </resources>
    </route>
</routes>
